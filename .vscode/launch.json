{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Launch WeatherDashboard",
            "request": "launch",
            "mainClass": "com.weather.dashboard.WeatherDashboard",
            "projectName": "weather-dashboard",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "WEATHER_API_KEY": "${env:WEATHER_API_KEY}"
            }
        }
    ]
}
